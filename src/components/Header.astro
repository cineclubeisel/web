---
import { IconMenu } from "@tabler/icons-astro";
import Logo from "./Logo.astro";

const title = Astro.props.title ?? "Cineclube ISEL";
---

<header class="on-top">
    <Logo />
    <button class="title-btn" title="Voltar ao topo">
        <h1>{title}</h1>
    </button>
    <button class="menu-btn" title="Mostrar menu">
        <IconMenu />
    </button>
</header>

<script>
    const $header = document.querySelector("header")!;
    const $titleBtn = $header.querySelector<HTMLButtonElement>(".title-btn")!;
    const $menuBtn = $header.querySelector<HTMLButtonElement>(".menu-btn")!;

    function onTop() {
        $header.classList.toggle("on-top", scrollY === 0);
    }
    addEventListener("scroll", onTop);
    onTop();

    $titleBtn.addEventListener("click", () => {
        scrollTo(0, 0);
        if (!$menu.classList.contains("off")) toggleMenu();
    });

    function toggleMenu() {
        if ($menu.classList.toggle("off")) {
            // menu off

            $header.classList.remove("menu-open");
            $menuBtn.title = "Mostrar menu";
        } else {
            // menu on

            $header.classList.add("menu-open");
            $menuBtn.title = "Esconder menu";
        }
    }

    const $menu = document.querySelector("menu")!;
    $menuBtn.addEventListener("click", toggleMenu);
</script>

<style>
    header {
        position: fixed;
        top: 0;
        left: 0;
        width: calc(100% - 2rem);
        height: 5rem;

        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem;
        gap: 1rem;

        /* TODO: make better responsiveness */
        max-width: calc(800px - 2rem);
        left: 50%;
        translate: -50% 0;

        &::before {
            content: "";

            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;

            background-image: linear-gradient(
                hsl(0, 0%, 0%) 0%,
                hsla(0, 0%, 0%, 0.9) 0.7%,
                hsla(0, 0%, 0%, 0.801) 2.5%,
                hsla(0, 0%, 0%, 0.704) 5.6%,
                hsla(0, 0%, 0%, 0.609) 9.7%,
                hsla(0, 0%, 0%, 0.519) 14.8%,
                hsla(0, 0%, 0%, 0.432) 20.8%,
                hsla(0, 0%, 0%, 0.351) 27.6%,
                hsla(0, 0%, 0%, 0.276) 35.1%,
                hsla(0, 0%, 0%, 0.208) 43.2%,
                hsla(0, 0%, 0%, 0.148) 51.9%,
                hsla(0, 0%, 0%, 0.097) 60.9%,
                hsla(0, 0%, 0%, 0.056) 70.4%,
                hsla(0, 0%, 0%, 0.025) 80.1%,
                hsla(0, 0%, 0%, 0.007) 90%,
                hsla(0, 0%, 0%, 0) 100%
            );

            transition: opacity 0.3s;
        }

        z-index: 2;

        &.on-top::before {
            opacity: 0;
        }

        &.menu-open {
            &::before {
                opacity: 0;
            }

            .logo svg:first-child {
                scale: 0;
            }

            .title-btn h1 {
                text-shadow: 0 0 5px #0000;
            }

            .menu-btn svg {
                filter: drop-shadow(0 0 5px #0000);
            }
        }

        .title-btn {
            h1 {
                text-shadow: 0 0 5px #0008;
                white-space: nowrap;
                transition:
                    letter-spacing 0.3s,
                    text-shadow 0.3s;
            }

            &:hover {
                h1 {
                    letter-spacing: 0;
                }
            }
        }

        .menu-btn svg {
            width: 2rem;
            height: 2rem;
            filter: drop-shadow(0 0 5px #0008);
            transition: filter 0.3s;
        }
    }

    @media (max-width: 400px) {
        .title-btn {
            display: none;
        }
    }
</style>
